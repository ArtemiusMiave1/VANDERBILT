  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1dceb7e5901e35945a8a2cf620c2eaed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialHighlight: {fileID: 7139318388342877077}
  tutorialPanel: {fileID: 7757834305873261566}
  instructionText: {fileID: 4477182437964379504}
  stepNameText: {fileID: 8206475187144517148}
  progressText: {fileID: 4805435329982207234}
  startOnAwake: 1
  hidePanelOnCompletion: 0
  completionMessage: "Well done captain. \nPress ESC and head back to the menu to
    begin your work shift."
  steps:
  - stepName: Pick Up Request
    instruction: Select a request on the request line
    stepObjects: []
    highlightIndices: 00000000
    interactionType: 2
    requiredObject: {fileID: 0}
    requiredDestination: {fileID: 0}
  - stepName: Discard request
    instruction: Click on the bottom request line
    stepObjects: []
    highlightIndices: 07000000
    interactionType: 4
    requiredObject: {fileID: 0}
    requiredDestination: {fileID: 0}
  - stepName: Accept request
    instruction: Place request on the corkboard
    stepObjects: []
    highlightIndices: 01000000
    interactionType: 3
    requiredObject: {fileID: 0}
    requiredDestination: {fileID: 0}
  - stepName: Route towards a resource depot
    instruction: Drag the string to the resource depot location
    stepObjects: []
    highlightIndices: 0200000009000000
    interactionType: 5
    requiredObject: {fileID: 0}
    requiredDestination: {fileID: 1536468816714484836}
  - stepName: Adjust speed
    instruction: 'Left click on the handle and drag to adjust speed

      More speed
      uses more fuel'
    stepObjects: []
    highlightIndices: 05000000
    interactionType: 0
    requiredObject: {fileID: 4251709335868008979}
    requiredDestination: {fileID: 0}
  - stepName: 'Confirm Route '
    instruction: Click button
    stepObjects: []
    highlightIndices: 0a000000
    interactionType: 0
    requiredObject: {fileID: 6931395814361402691}
    requiredDestination: {fileID: 0}
  - stepName: Look at resources
    instruction: 'Press TAB to bring up your clipboard '
    stepObjects: []
    highlightIndices: 
    interactionType: 6
    requiredObject: {fileID: 0}
    requiredDestination: {fileID: 0}
  - stepName: Purchase resources
    instruction: 'Click on the paper at the fax machine to bring up the order form '
    stepObjects: []
    highlightIndices: 03000000
    interactionType: 0
    requiredObject: {fileID: 2917299220127984214}
    requiredDestination: {fileID: 0}
  - stepName: 'Deliver Request '
    instruction: 'Route you path towards the destination and travel there.


      Right
      clicking on a location removes the route.'
    stepObjects: []
    highlightIndices: 02000000
    interactionType: 7
    requiredObject: {fileID: 0}
    requiredDestination: {fileID: 0}
  - stepName: Check your fuel and collect payment
    instruction: 'Vanderbilt HQ to collect your request payments


      Make sure
      to check the fuel tank for when you''re running low!'
    stepObjects: []
    highlightIndices: 0400000008000000
    interactionType: 8
    requiredObject: {fileID: 0}
    requiredDestination: {fileID: 0}
  currentStep: -1
  tutorialActive: 0
  tutorialCompleted: 0
